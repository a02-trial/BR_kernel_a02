ARCH=arm
CC=clang
HOSTCC=clang
DEFCONFIG="a02_defconfig"
CROSS_COMPILE=arm-linux-androidkernel-
CLANG_TRIPLE=arm-linux-gnueabi-
CLANG_PREBUILT_BIN=prebuilts-master/clang/host/linux-x86/clang-r450784d/bin
BUILDTOOLS_PREBUILT_BIN=build/build-tools/path/linux-x86
LINUX_GCC_CROSS_COMPILE_PREBUILTS_BIN=prebuilts/gas/linux-x86
LINUX_GCC_CROSS_COMPILE_COMPAT_PREBUILTS_BIN=prebuilts/gas/linux-x86

FILES="
arch/arm/boot/Image
arch/arm/boot/zImage
vmlinux
System.map
"

EXTRA_CMDS=''
STOP_SHIP_TRACEPRINTK=1
IN_KERNEL_MODULES=1
